# Supabase (project: healthtracker, krgmjucvoiuijyariyxl)
# Get these from https://supabase.com/dashboard/project/krgmjucvoiuijyariyxl/settings/api-keys
# ("Publishable and secret API keys" tab — click "Create new API keys" if you only see
# legacy anon/service_role keys. Supabase is retiring anon/service_role through 2026.)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Google Health API OAuth client
# Create at https://console.cloud.google.com, then follow developers.google.com/health/setup
# to enable the Google Health API and configure the OAuth consent screen.
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the OAuth client
# (Google Cloud Console > APIs & Services > Credentials > your OAuth client > Authorized redirect URIs).
GOOGLE_HEALTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Base URL of this app (no trailing slash).
APP_BASE_URL=http://localhost:3000

# Shared secret Vercel Cron sends as `Authorization: Bearer $CRON_SECRET` when it
# invokes /api/sync. Generate with: openssl rand -hex 32
CRON_SECRET=

# Web Push (Smart Alarm). Generate a keypair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI required by the Web Push protocol (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com
